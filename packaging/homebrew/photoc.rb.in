class Photoc < Formula
  desc "Command-line tools for photographers"
  homepage "https://github.com/ahmetomerv/photoc"
  url "https://github.com/ahmetomerv/photoc/archive/refs/tags/v@VERSION@.tar.gz"
  sha256 "@SHA256@"
  license "MIT"

  depends_on "cmake" => :build
  depends_on "pkgconf" => :build
  depends_on "jpeg-turbo"
  depends_on "libexif"

  def install
    odie "Source VERSION does not match formula version" unless (buildpath/"VERSION").read.strip == version.to_s

    system "cmake", "-S", ".", "-B", "build", "-DBUILD_TESTING=OFF", *std_cmake_args
    system "cmake", "--build", "build"
    system "cmake", "--install", "build"

    bash_completion.install "completions/bash/photoc"
    zsh_completion.install "completions/zsh/_photoc"
    fish_completion.install "completions/fish/photoc.fish"
  end

  test do
    assert_equal "photoc #{version}\n", shell_output("#{bin}/photoc --version")
    assert_path_exists man1/"photoc.1"
    assert_path_exists bash_completion/"photoc"
    assert_path_exists zsh_completion/"_photoc"
    assert_path_exists fish_completion/"photoc.fish"
  end
end
